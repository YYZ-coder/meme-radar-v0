+func TestParserReparsesRetriedBlocks(t *testing.T) {
+	ctx := context.Background()
+	st, c := setup(t)
+	commit(t, st, 7, []byte(`{}`))
+	bad := parser.New(parser.Config{Chain: "solana", Store: st, Version: 8, Batch: 10, Decode: func(context.Context, []byte) (parser.Decoded, error) {
+		return parser.Decoded{Facts: parse.Facts{Failures: []parse.Failure{{Tx: 2, Decoder: "pump_fun", Err: "old failure"}, {Tx: 3, Decoder: "pumpswap", Err: "old failure"}}}}, nil
+	}})
+	if _, err := bad.Step(ctx); err != nil {
+		t.Fatal(err)
+	}
+	rows, err := c.Query(ctx, `SELECT id FROM decode_failures WHERE chain='solana' ORDER BY id`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ids, err := pgx.CollectRows(rows, pgx.RowTo[int64])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ids) != 2 {
+		t.Fatalf("fixture failures=%v; want two", ids)
+	}
+	for _, id := range ids {
+		if _, err := st.QueueParseRetry(ctx, id, time.Now().UTC()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// The base chain has the same block number: a solana step must leave it alone.
+	at := time.Unix(1792719992, 0)
+	if err := st.Commit(ctx, store.Commit{Chain: "base", Block: store.Block{Num: 7, Hash: []byte{7}, Time: at, Status: store.StatusConfirmed, Payload: []byte(`{}`), Source: "test"}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := st.ApplyParsed(ctx, store.Parsed{Chain: "base", Num: 7, Time: at, Version: 8, Facts: parse.Facts{Failures: []parse.Failure{{Tx: 1, Decoder: "doppler", Err: "base failure"}}}}); err != nil {
+		t.Fatal(err)
+	}
+	var other int64
+	if err := c.QueryRow(ctx, `SELECT id FROM decode_failures WHERE chain='base'`).Scan(&other); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := st.QueueParseRetry(ctx, other, time.Now().UTC()); err != nil {
+		t.Fatal(err)
+	}
+	good := parser.New(parser.Config{Chain: "solana", Store: st, Version: 8, Batch: 10, Decode: func(context.Context, []byte) (parser.Decoded, error) {
+		return parser.Decoded{Facts: parse.Facts{Tokens: []parse.Token{{Address: make([]byte, 32), Created: true, Symbol: "RECOVERED"}}}}, nil
+	}})
+	if _, err := good.Step(ctx); err != nil {
+		t.Fatal(err)
+	}
+	for sql, want := range map[string]string{
+		`SELECT count(*)::text FROM decode_failures WHERE chain='solana'`:                       "0",
+		`SELECT count(*)::text FROM parse_retries WHERE chain='solana' AND done_at IS NOT NULL`: "2",
+		`SELECT parsed_version::text FROM chain_blocks WHERE chain='solana' AND block_num=7`:    "8",
+		`SELECT count(*)::text FROM tokens WHERE chain='solana' AND symbol='RECOVERED'`:         "1",
+		`SELECT count(*)::text FROM parse_retries WHERE chain='base' AND done_at IS NULL`:       "1",
+		`SELECT count(*)::text FROM decode_failures WHERE chain='base'`:                         "1",
+	} {
+		if got := query(t, c, sql); got != want {
+			t.Errorf("%s=%s; want %s", sql, got, want)
+		}
+	}
+}
