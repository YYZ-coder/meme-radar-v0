+func TestParserRetryMetrics(t *testing.T) {
+	ctx := context.Background()
+	st, c := setup(t)
+	commit(t, st, 7, []byte(`{}`))
+	at := time.Unix(1792719992, 0)
+	if err := st.ApplyParsed(ctx, store.Parsed{Chain: "solana", Num: 7, Time: at, Version: 8, Facts: parse.Facts{Failures: []parse.Failure{{Tx: 1, Decoder: "pump_fun", Err: "old failure"}}}}); err != nil {
+		t.Fatal(err)
+	}
+	var id int64
+	if err := c.QueryRow(ctx, `SELECT id FROM decode_failures`).Scan(&id); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := st.QueueParseRetry(ctx, id, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	before := testutil.ToFloat64(metrics.ParseRetryBlocks.WithLabelValues("solana"))
+	p := parser.New(parser.Config{Chain: "solana", Store: st, Version: 8, Batch: 10, Decode: func(context.Context, []byte) (parser.Decoded, error) { return parser.Decoded{}, nil }})
+	for i := 0; i < 2; i++ {
+		if _, err := p.Step(ctx); err != nil {
+			t.Fatal(err)
+		}
+		if got := testutil.ToFloat64(metrics.ParseRetryBlocks.WithLabelValues("solana")) - before; got != 1 {
+			t.Fatalf("reset blocks increment=%v after step %d; want 1 even after the next empty step", got, i+1)
+		}
+	}
+}
