# Read-only SQL preview (no DDL, schema 0010):
WITH windows AS (
		SELECT seconds, n, timestamptz '2026-10-23 14:19:00+00'::timestamptz - seconds * interval '1 second' AS from_time
		FROM unnest(ARRAY[86400]::bigint[]::bigint[]) WITH ORDINALITY AS w(seconds, n)
	)
	SELECT w.seconds,
		EXISTS (SELECT 1 FROM coverage_ranges cr WHERE cr.chain='bsc'::chain_id AND cr.from_time<=w.from_time AND cr.to_time >= timestamptz '2026-10-23 14:19:00+00'),
		v.trades, v.buys, v.sells, trim_scale(v.volume)::text, trim_scale(v.buy)::text, trim_scale(v.sell)::text,
		trim_scale(v.buy-v.sell)::text, wallets.traders,
  trim_scale(round(round((tm.price_usd - coalesce(previous.price,first_inside.price))*100,
   scale((tm.price_usd - coalesce(previous.price,first_inside.price))*100)+40) /
   nullif(coalesce(previous.price,first_inside.price),0),20))::text
	FROM windows w CROSS JOIN LATERAL (
		SELECT coalesce(sum(ps.trades),0)::bigint AS trades, coalesce(sum(ps.buys),0)::bigint AS buys,
			coalesce(sum(ps.sells),0)::bigint AS sells,
			CASE WHEN NOT coalesce(bool_or(ps.unpriced_trades>0),false) THEN coalesce(sum(ps.volume_usd),0) END AS volume,
			CASE WHEN count(*) FILTER (WHERE ps.buy_volume_usd IS NULL)=0 THEN coalesce(sum(ps.buy_volume_usd),0) END AS buy,
			CASE WHEN count(*) FILTER (WHERE ps.sell_volume_usd IS NULL)=0 THEN coalesce(sum(ps.sell_volume_usd),0) END AS sell
		FROM pool_minute_stats ps WHERE ps.chain='bsc'::chain_id AND ps.token_address=decode('71c7667fa365e818fa083fbdb40765267d7b4444','hex') AND ps.minute>=w.from_time AND ps.minute<timestamptz '2026-10-23 14:19:00+00'
	) v CROSS JOIN LATERAL (
		SELECT count(DISTINCT t.wallet) AS traders FROM trades t
		WHERE t.chain='bsc'::chain_id AND t.token_address=decode('71c7667fa365e818fa083fbdb40765267d7b4444','hex') AND t.block_time>=w.from_time AND t.block_time<timestamptz '2026-10-23 14:19:00+00'
	) wallets
 LEFT JOIN token_market tm ON tm.chain='bsc'::chain_id AND tm.address=decode('71c7667fa365e818fa083fbdb40765267d7b4444','hex')
 LEFT JOIN LATERAL (
  SELECT CASE WHEN false THEN CASE WHEN t.value_usd>0 THEN t.price_usd*t.value_native/t.value_usd END ELSE t.price_usd END AS price FROM trades t
  WHERE t.chain='bsc'::chain_id AND t.token_address=decode('71c7667fa365e818fa083fbdb40765267d7b4444','hex') AND t.block_time<w.from_time AND t.price_usd IS NOT NULL
   AND t.pool_id=coalesce((SELECT ps.to_pool FROM pool_switches ps WHERE ps.chain=t.chain AND ps.token_address=t.token_address AND ps.t<=t.block_time ORDER BY ps.t DESC LIMIT 1),(SELECT ps.to_pool FROM pool_switches ps WHERE ps.chain=t.chain AND ps.token_address=t.token_address ORDER BY ps.t LIMIT 1)) AND (CASE WHEN false THEN CASE WHEN t.value_usd>0 THEN t.price_usd*t.value_native/t.value_usd END ELSE t.price_usd END) IS NOT NULL
  ORDER BY t.block_time DESC,t.block_num DESC,t.tx_index DESC,t.ix_index DESC LIMIT 1
 ) previous ON true
 LEFT JOIN LATERAL (
  SELECT CASE WHEN false THEN CASE WHEN t.value_usd>0 THEN t.price_usd*t.value_native/t.value_usd END ELSE t.price_usd END AS price FROM trades t
  WHERE previous.price IS NULL AND t.chain='bsc'::chain_id AND t.token_address=decode('71c7667fa365e818fa083fbdb40765267d7b4444','hex') AND t.block_time>=w.from_time AND t.block_time<timestamptz '2026-10-23 14:19:00+00'
   AND t.price_usd IS NOT NULL AND t.pool_id=coalesce((SELECT ps.to_pool FROM pool_switches ps WHERE ps.chain=t.chain AND ps.token_address=t.token_address AND ps.t<=t.block_time ORDER BY ps.t DESC LIMIT 1),(SELECT ps.to_pool FROM pool_switches ps WHERE ps.chain=t.chain AND ps.token_address=t.token_address ORDER BY ps.t LIMIT 1)) AND (CASE WHEN false THEN CASE WHEN t.value_usd>0 THEN t.price_usd*t.value_native/t.value_usd END ELSE t.price_usd END) IS NOT NULL
  ORDER BY t.block_time,t.block_num,t.tx_index,t.ix_index LIMIT 1
 ) first_inside ON true
 ORDER BY w.n

