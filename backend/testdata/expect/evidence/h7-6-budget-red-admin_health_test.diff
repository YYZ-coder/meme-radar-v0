+func TestRetryFailureQueuesOnce(t *testing.T) {
+	f := newFixture(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	id := f.failure(t, "bsc", 77, 3, "four_meme", f.now.Add(-time.Hour))
+	b := pgapi.New(f.st, f.cfg, func() time.Time { return f.now })
+	snapshot := func() string {
+		t.Helper()
+		var s string
+		if err := f.conn.QueryRow(ctx, `SELECT jsonb_build_object('blocks',(SELECT jsonb_agg(to_jsonb(b)) FROM chain_blocks b),'failures',(SELECT jsonb_agg(to_jsonb(f)) FROM decode_failures f))::text`).Scan(&s); err != nil {
+			t.Fatal(err)
+		}
+		return s
+	}
+	before := snapshot()
+	h := f.handler()
+	request := routeRequest{method: http.MethodPost, route: "/api/v1/admin/parse-failures/{id}/retry", target: fmt.Sprintf("/api/v1/admin/parse-failures/%d/retry", id), status: http.StatusAccepted}
+	var first, second api.ParseFailure
+	for _, out := range []*api.ParseFailure{&first, &second} {
+		rec := requestPG(t, h, request) // asserts 202 and validates the real HTTP response against OpenAPI
+		if err := json.Unmarshal(rec.Body.Bytes(), out); err != nil {
+			t.Fatal(err)
+		}
+	}
+	want := api.ParseFailure{ID: fmt.Sprint(id), Chain: api.BSC, Module: "four_meme", Position: "77/3", Error: "independent fixture failure", Attempts: 1, Status: "queued", LastAttemptAt: "2026-10-23T09:00:30.000Z"}
+	if first != want || second != want {
+		t.Fatalf("retry=%+v then %+v; want %+v both times", first, second, want)
+	}
+	var wg sync.WaitGroup
+	errs := make(chan error, 12)
+	start := make(chan struct{})
+	for i := 0; i < 12; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			got, err := b.RetryFailure(ctx, fmt.Sprint(id))
+			if err != nil {
+				errs <- err
+			} else if got != want {
+				errs <- fmt.Errorf("concurrent retry=%+v; want %+v", got, want)
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		t.Error(err)
+	}
+	var count int
+	var requested time.Time
+	if err := f.conn.QueryRow(ctx, `SELECT count(*),min(requested_at) FROM parse_retries WHERE failure_id=$1`, id).Scan(&count, &requested); err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 || !requested.Equal(f.now) {
+		t.Errorf("queued rows=%d at %s; want 1 at request clock", count, requested)
+	}
+	if after := snapshot(); after != before {
+		t.Error("API changed parser-owned chain_blocks/decode_failures")
+	}
+	requestPG(t, h, routeRequest{method: http.MethodPost, route: request.route, target: "/api/v1/admin/parse-failures/999999999/retry", status: http.StatusNotFound})
+	for _, missing := range []string{"999999999", "bad-id", "-1", "9223372036854775808"} {
+		_, err := b.RetryFailure(ctx, missing)
+		var e *api.Error
+		if !errors.As(err, &e) || e.Status != 404 || e.Code != "not_found" {
+			t.Errorf("retry missing %s: %v; want 404 not_found", missing, err)
+		}
+	}
+}
