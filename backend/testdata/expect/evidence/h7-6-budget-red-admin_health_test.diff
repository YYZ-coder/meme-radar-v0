+// failure sets the time at the agreed persistence seam: ApplyParsed uses the
+// database clock, so only created_at is adjusted to this fixture's fixed clock.
+func (f *fixture) failure(t *testing.T, chain string, num uint64, tx int, decoder string, at time.Time) int64 {
+	t.Helper()
+	f.apply(t, chain, num, f.now.Add(-time.Minute), parse.Facts{Failures: []parse.Failure{{Tx: tx, Decoder: decoder, Err: "independent fixture failure"}}})
+	var id int64
+	if err := f.conn.QueryRow(context.Background(), `UPDATE decode_failures SET created_at=$3 WHERE chain=$1 AND block_num=$2 RETURNING id`, chain, int64(num), at).Scan(&id); err != nil {
+		t.Fatal(err)
+	}
+	return id
+}
