+func TestHealthParsers(t *testing.T) {
+	f := newFixture(t)
+	ctx := context.Background()
+	if err := f.st.SaveParserStatus(ctx, "bsc", 8, []string{"four_meme", "pancake_v2"}, f.now.Add(-time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	f.apply(t, "bsc", 980, f.now.Add(-time.Minute), parse.Facts{})
+	var blocks []store.Commit
+	for n := uint64(981); n <= 1000; n++ {
+		blocks = append(blocks, store.Commit{Chain: "bsc", Block: store.Block{Num: n, Hash: raw(32, byte(n)), Time: f.now, Status: store.StatusConfirmed, Payload: []byte(`{}`), Source: "test"}})
+	}
+	// A skipped slot is processed coverage, not parser backlog.
+	blocks = append(blocks, store.Commit{Chain: "bsc", Block: store.Block{Num: 1001, Status: store.StatusSkipped}})
+	if err := f.st.CommitBlocks(ctx, blocks); err != nil {
+		t.Fatal(err)
+	}
+	queued := f.failure(t, "bsc", 970, 1, "four_meme", f.now.Add(-time.Hour))
+	f.failure(t, "bsc", 971, 2, "four_meme", f.now.Add(-2*time.Hour))
+	f.failure(t, "bsc", 972, 3, "four_meme", f.now.Add(-24*time.Hour)) // inclusive lower boundary
+	f.failure(t, "bsc", 973, 4, "four_meme", f.now.Add(-24*time.Hour-time.Microsecond))
+	f.failure(t, "bsc", 974, 5, "four_meme", f.now.Add(time.Microsecond)) // future is not recent
+	f.failure(t, "base", 975, 6, "four_meme", f.now.Add(-time.Hour))
+	if _, err := f.conn.Exec(ctx, `INSERT INTO parse_retries(chain,block_num,failure_id,requested_at) VALUES ('bsc',970,$1,$2)`, queued, f.now); err != nil {
+		t.Fatal(err)
+	}
+	h, err := pgapi.New(f.st, f.cfg, func() time.Time { return f.now }).Health(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(h.Parsers) != 2 {
+		t.Fatalf("parsers=%+v; want only 2 enabled modules registered by parse", h.Parsers)
+	}
+	for _, p := range h.Parsers {
+		if p.Chain != api.BSC || p.Version != "8" || p.Position == nil || *p.Position != 980 || p.LagBlocks == nil || *p.LagBlocks != 20 || p.UnknownDiscriminators != 0 {
+			t.Errorf("parser=%+v; want bsc/version8/position980/lag20/unknown0", p)
+		}
+		switch p.Module {
+		case "four_meme":
+			if p.Failures != 3 || p.Quarantined != 2 {
+				t.Errorf("four_meme=%+v; want 3 recent failures, 2 without pending retry", p)
+			}
+		case "pancake_v2":
+			if p.Failures != 0 || p.Quarantined != 0 {
+				t.Errorf("pancake=%+v; want zero", p)
+			}
+		default:
+			t.Errorf("unexpected module %q", p.Module)
+		}
+	}
+}
