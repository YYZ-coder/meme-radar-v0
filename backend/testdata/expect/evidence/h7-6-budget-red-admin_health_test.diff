+func TestHealthChains(t *testing.T) {
+	f := healthFixture(t)
+	ctx := context.Background()
+	rows, err := f.st.HealthChains(ctx, []store.HealthChainConfig{{Chain: "bsc", WindowBlocks: 100}, {Chain: "base"}, {Chain: "solana"}}, f.now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 3 {
+		t.Fatalf("store chain rows=%d; want 3 configured chains", len(rows))
+	}
+	if rows[0].Head == nil || *rows[0].Head != 1000 || rows[0].BacklogBlocks == nil || *rows[0].BacklogBlocks != 10 {
+		t.Fatalf("store bsc=%+v; want head=1000/backlog=10", rows[0])
+	}
+	h, err := pgapi.New(f.st, f.cfg, func() time.Time { return f.now }).Health(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if h.AsOf != "2026-10-23T10:00:30.000Z" || len(h.Chains) != 3 {
+		t.Fatalf("health=%+v", h)
+	}
+	c := h.Chains[0]
+	if c.Chain != api.BSC || c.Head == nil || *c.Head != 1000 || c.Anchor != 950 || c.ForwardPosition == nil || *c.ForwardPosition != 990 || c.BacklogBlocks == nil || *c.BacklogBlocks != 10 || c.LagSeconds == nil || *c.LagSeconds != 7 || c.LowerBound != 900 || c.HistoryPosition == nil || *c.HistoryPosition != 910 || c.GapsOpen != 2 || !reflect.DeepEqual(c.GapsByReason, map[string]int64{"startup": 1, "rate_limited": 1}) || c.BudgetPaused {
+		t.Fatalf("bsc=%+v; want head=1000 anchor=950 forward=990 backlog=10 lag=7 lower=900 history=910 two gap rows", c)
+	}
+	if c.LastError == nil || c.LastError.Kind != "retryable" || c.LastError.Message != "429 Too Many Requests" {
+		t.Errorf("last_error=%+v", c.LastError)
+	}
+	if c := h.Chains[1]; c.LowerBound != 11 || c.HistoryPosition != nil || c.LastError != nil {
+		t.Errorf("no backfill/coverage: %+v", c)
+	}
+	if c := h.Chains[2]; c.Head != nil || c.ForwardPosition != nil || c.BacklogBlocks != nil || c.LagSeconds != nil || c.HistoryPosition != nil || c.LastError != nil || c.GapsOpen != 0 || c.GapsByReason == nil {
+		t.Errorf("missing cursor must stay unknown: %+v", c)
+	}
+	for _, tc := range []struct{ kind, message, want string }{{"error", "HTTP 401 Unauthorized", "config"}, {"rate_limited", "HTTP 403 Forbidden", "config"}, {"error", "connection reset", "retryable"}, {"not_found", "missing block", "not_found"}, {"history_unavailable", "pruned", "history_unavailable"}, {"incomplete", "partial receipt", "incomplete"}} {
+		if err := f.st.SetForwardError(ctx, "bsc", tc.kind, tc.message); err != nil {
+			t.Fatal(err)
+		}
+		got, err := pgapi.New(f.st, f.cfg, func() time.Time { return f.now }).Health(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got.Chains[0].LastError == nil || got.Chains[0].LastError.Kind != tc.want {
+			t.Errorf("kind %s message %s: %+v; want %s", tc.kind, tc.message, got.Chains[0].LastError, tc.want)
+		}
+	}
+}
