+func TestHealthBudget(t *testing.T) {
+	f := newFixture(t)
+	for _, tc := range []struct {
+		now          time.Time
+		month, stamp string
+	}{
+		{time.Date(2026, 11, 1, 7, 59, 59, 0, time.FixedZone("UTC+8", 8*3600)), "2026-10", "2026-10-31T23:59:59.000Z"},
+		{time.Date(2026, 11, 1, 0, 0, 0, 0, time.UTC), "2026-11", "2026-11-01T00:00:00.000Z"},
+	} {
+		f.now = tc.now
+		rec := requestPG(t, f.handler(), routeRequest{method: http.MethodGet, route: "/api/v1/admin/health", target: "/api/v1/admin/health", status: http.StatusOK})
+		var h api.AdminHealth
+		if err := json.Unmarshal(rec.Body.Bytes(), &h); err != nil {
+			t.Fatal(err)
+		}
+		want := api.Budget{Month: tc.month, SpentUSD: "0", LimitUSD: "100", State: "normal"}
+		if h.Budget != want || h.AsOf != tc.stamp {
+			t.Errorf("budget=%+v as_of=%s; want %+v as_of=%s", h.Budget, h.AsOf, want, tc.stamp)
+		}
+		if h.Chains == nil || h.Parsers == nil || h.Failures == nil {
+			t.Error("collections must encode as arrays, including empty parsers/failures")
+		}
+		for _, c := range h.Chains {
+			if c.BudgetPaused {
+				t.Errorf("placeholder budget must not pause chain %s", c.Chain)
+			}
+		}
+	}
