+func TestHealthFailures(t *testing.T) {
+	f := newFixture(t)
+	ctx := context.Background()
+	ids := make([]int64, 60)
+	for i := 0; i < 60; i++ {
+		at := f.now.Add(time.Duration(i-60) * time.Minute)
+		if i == 58 {
+			at = f.now.Add(-time.Minute)
+		} // tie: higher id wins deterministically
+		ids[i] = f.failure(t, "bsc", uint64(100+i), i, "four_meme", at)
+	}
+	if _, err := f.conn.Exec(ctx, `INSERT INTO parse_retries(chain,block_num,failure_id,requested_at,done_at) VALUES
+ ('bsc',159,$1,$4,NULL),('bsc',158,$2,$4,$4),('bsc',158,$2,$4,$4),('base',158,$3,$4,$4)`, ids[59], ids[58], ids[0], f.now); err != nil {
+		t.Fatal(err)
+	}
+	h, err := pgapi.New(f.st, f.cfg, func() time.Time { return f.now }).Health(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(h.Failures) != 50 {
+		t.Fatalf("failures=%d; want newest 50 of 60", len(h.Failures))
+	}
+	for i, item := range h.Failures {
+		wantIndex := 59 - i
+		if item.ID != fmt.Sprint(ids[wantIndex]) || item.Chain != api.BSC || item.Module != "four_meme" || item.Position != fmt.Sprintf("%d/%d", 100+wantIndex, wantIndex) || item.Error != "independent fixture failure" {
+			t.Errorf("failure[%d]=%+v; want fixture index %d", i, item, wantIndex)
+		}
+	}
+	if got := h.Failures[0]; got.Status != "queued" || got.Attempts != 1 || got.LastAttemptAt != "2026-10-23T09:59:30.000Z" {
+		t.Errorf("pending=%+v; want queued, attempts=1, original created_at", got)
+	}
+	if got := h.Failures[1]; got.Status != "failed" || got.Attempts != 3 {
+		t.Errorf("executed=%+v; want failed, attempts=3 (two executed block retries, exclude other chain)", got)
+	}
+	if got := h.Failures[49]; got.Status != "failed" || got.Attempts != 1 {
+		t.Errorf("last=%+v; want untouched failure", got)
+	}
+}
