#!/usr/bin/env bash
# Validate exactly the staged inputs; never enlarge the user's staging selection.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo 'Commit checks need the staged inputs to match the working tree. Review and stage your intended files; nothing was added automatically.' >&2
  exit 1
fi
front=()
while IFS= read -r -d '' file; do
  [ -f "$file" ] || continue
  case "$file" in
    backend/*.go) gofmt -w "$file" ;;
    frontend/*.ts|frontend/*.tsx|frontend/*.css|frontend/*.mjs|frontend/*.json)
      case "$file" in frontend/src/lib/api/schema.gen.ts) ;; *) front+=("./${file#frontend/}") ;; esac ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if [ "${#front[@]}" -gt 0 ]; then
  (cd frontend && npx prettier --write -- "${front[@]}")
fi
if ! git diff --quiet; then
  echo 'Formatting changed staged source files. Review and stage those changes before committing.' >&2
  exit 1
fi
scripts/check-secrets.sh
make check
