{
  "uid": "radar-logs",
  "title": "Radar logs",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "type": "textbox",
        "label": "trace_id",
        "query": ""
      },
      {
        "name": "level",
        "type": "custom",
        "label": "level",
        "query": "INFO,WARN,ERROR,DEBUG",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "code",
        "type": "textbox",
        "label": "code",
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors",
      "datasource": {
        "type": "loki",
        "uid": "radar-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"radar\", level=\"ERROR\"}[$__range])) or vector(0)",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Panics recovered",
      "datasource": {
        "type": "loki",
        "uid": "radar-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"radar\", code=\"runtime.panic_recovered\"}[$__range])) or vector(0)",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Goroutine restarts",
      "datasource": {
        "type": "loki",
        "uid": "radar-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"radar\", code=\"runtime.goroutine_restarted\"}[$__range])) or vector(0)",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HTTP 5xx",
      "datasource": {
        "type": "loki",
        "uid": "radar-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"radar\"} | json | msg=\"http request\" | status >= 500 [$__range])) or vector(0)",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Log lines by code",
      "datasource": {
        "type": "loki",
        "uid": "radar-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (count_over_time({service=\"radar\", code=~\".+\"}[1m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs (filter by trace_id / level / code)",
      "datasource": {
        "type": "loki",
        "uid": "radar-loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"radar\", level=~\"${level:regex}\"} |~ \"${trace_id}\" |~ \"${code}\""
        }
      ]
    }
  ]
}