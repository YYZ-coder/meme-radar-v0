// Grafana Alloy: ship radar JSON logs to Loki (18-observability §5).
// Sources: the file written by `make -C backend run` (.local/logs/*.log) and any
// container labelled radar.logs=true.

local.file_match "radar_files" {
  path_targets = [{"__path__" = "/var/log/radar/*.log", "source" = "file"}]
}

loki.source.file "radar_files" {
  targets    = local.file_match.radar_files.targets
  forward_to = [loki.process.radar.receiver]
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["radar.logs=true"]
  }
}

loki.source.docker "radar_containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.process.radar.receiver]
}

loki.process "radar" {
  stage.json {
    expressions = { level = "level", service = "service", role = "role", code = "code", time = "time" }
  }
  // Low-cardinality fields only as labels; trace_id and addresses stay in the line.
  stage.labels {
    values = { level = "", service = "", role = "", code = "" }
  }
  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
