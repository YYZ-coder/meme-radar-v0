# Copy to .env (git-ignored) for `make ingest-up`. Never commit real credentials.
# Tencent Cloud PostgreSQL: allow this machine's public IP in the instance's
# security group; the user needs CREATE on the database (migrations, daily
# partitions). sslmode=require encrypts without verifying the server CA.
RADAR_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Grafana (make obs-up, http://127.0.0.1:3301): admin password; bound to localhost only.
GRAFANA_ADMIN_PASSWORD=change-me
# Pyth Hermes key, only when prices.sources lists pyth (D147).
# RADAR_PYTH_API_KEY=

# Alert emails (make obs-up): Alertmanager sends firing/resolved alerts to
# ALERT_EMAIL_TO through this SMTP account. For Gmail use an app password
# (Google account > Security > 2-Step Verification > App passwords).
ALERT_EMAIL_TO=yuezhangwork812@gmail.com
ALERT_SMTP_HOST=smtp.gmail.com:587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# ALERT_SMTP_FROM defaults to ALERT_SMTP_USER
